#!/bin/bash

ACCEL_PROF_DIR=$(pwd)
if [ ! -f "${ACCEL_PROF_DIR}/bin/clean" ]; then
    echo "Please run this script in the root directory of AccelProf"
    exit 1
fi

# The GPU backends (nv-compute, nv-nvbit, amd-rocm), tensor_scope, sanalyzer and
# its cpp_trace/py_frame sub-projects used to be first-party submodules. They are
# now inlined into this repository, so only this repository and the third_party
# submodules are separate git trees.
BRANCH=${1:-main}

check_git_clean() {
  # Check for uncommitted changes
  if [[ -n $(git status --porcelain) ]]; then
    echo "❌ Error: Uncommitted changes found in the working directory."
    git status --short
    exit 1
  fi

  # Check for unpushed commits
  if [[ -n $(git log --branches --not --remotes) ]]; then
    echo "❌ Error: There are commits that have not been pushed to the remote."
    git --no-pager log --oneline --branches --not --remotes
    exit 1
  fi

  echo "✅ Git repository is clean and fully pushed."
}

cd "$ACCEL_PROF_DIR"
echo "🔍 Checking git status in $(basename "$ACCEL_PROF_DIR")"
check_git_clean

echo "✅ Syncing $(basename "$ACCEL_PROF_DIR") to $BRANCH"
git checkout -q "$BRANCH" || exit 1
git pull -q || exit 1

# third_party pins follow whatever the freshly pulled commit records
git submodule sync --recursive || exit 1
git submodule update --init --recursive || exit 1

echo "✅ Syncing done"
